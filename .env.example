# Copy to .env.local to enable accounts and sync in local development.
# Both values are on the Supabase dashboard under Project Settings -> API Keys.
# The publishable key is safe to expose; never put a secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
